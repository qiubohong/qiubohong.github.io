<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>HARNESS COMPONENTS</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 24 }}>Harness 六大组件，按优先级分 P0-P2 落地</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 24 }} />

    <Box style={{ flexDirection: 'row', gap: 32, flex: 1 }}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
        {[
          { n: '01', t: '系统提示词', d: '定义角色、规则与边界' },
          { n: '02', t: '工具集', d: '注册白名单，限定能力' },
          { n: '03', t: '中间件', d: 'Hooks 拦截，扩展日志/权限' },
          { n: '04', t: '上下文管理', d: '记忆注入、压缩、检索' },
          { n: '05', t: '执行流程', d: '循环、终止、错误处理' },
          { n: '06', t: '验证层', d: '输出校验、格式、质量门禁' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', borderRadius: 10, padding: '12px 18px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
            <Text style={{ fontSize: 15, color: '#FF9F1C', fontWeight: 'bold', width: 28 }}>{item.n}</Text>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16263F' }}>{item.t}</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#5B6B7A' }}>{item.d}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ flex: 1, flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
        <Box style={{ background: '#16263F', borderRadius: 12, padding: '18px 22px' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
            <Text style={{ fontSize: 13, color: '#FF9F1C', fontWeight: 'bold' }}>P0</Text>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>必须做（否则不可上线）</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#DCE7F5' }}>系统提示词 · 工具集 · 执行流程</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: '18px 22px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
            <Text style={{ fontSize: 13, color: '#FF9F1C', fontWeight: 'bold' }}>P1</Text>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16263F' }}>应该做（提质量提效率）</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#5B6B7A' }}>上下文管理 · 验证层</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: '18px 22px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
            <Text style={{ fontSize: 13, color: '#FF9F1C', fontWeight: 'bold' }}>P2</Text>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16263F' }}>可选做（锦上添花）</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#5B6B7A' }}>中间件（Hooks 扩展）</Text>
        </Box>
        <Box style={{ background: '#DCE7F5', borderRadius: 10, padding: '13px 20px' }}>
          <Text style={{ fontSize: 14, color: '#16263F', fontWeight: 'bold' }}>
            优先级心法：先守住 P0 底线，再逐步补 P1、P2
          </Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 8 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>03 / 12</Text>
  </Box>
</Slide>
