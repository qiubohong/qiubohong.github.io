<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>ELEMENT 03 · INSTRUCTION</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 14 }}>要素③指令：动词先行 + 结果导向</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 22 }} />

    <Box style={{ flexDirection: 'row', gap: 20, flex: 1 }}>
      {[
        { t: '笼统 → 具体', bad: '写点关于效率的东西', good: '列出 3 个提升程序员效率的方法，各配一句说明', icon: 'bullseye' },
        { t: '多指令混杂 → 分步', bad: '改代码、写注释、加测试一起弄', good: '第一步只做重构，确认后再进入下一步', icon: 'list-ol' },
        { t: '无约束 → 约束绑定', bad: '写个产品介绍', good: '写 150 字内，面向初学者，用大白话', icon: 'link' },
      ].map((item, idx) => (
        <Box key={idx} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '22px 22px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 14 }}>
            <Box style={{ width: 38, height: 38, borderRadius: 10, background: '#EAF2FB', justifyContent: 'center', alignItems: 'center' }}>
              <FAIcon name={item.icon} style={{ fill: '#22D3EE', width: 18, height: 18 }} />
            </Box>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16263F' }}>{item.t}</Text>
          </Box>
          <Box style={{ background: '#F5F7FA', borderRadius: 8, padding: '10px 14px', marginBottom: 10 }}>
            <Text style={{ fontSize: 13, color: '#FF9F1C', fontWeight: 'bold', marginBottom: 4 }}>反例</Text>
            <Text style={{ fontSize: 14, color: '#5B6B7A', lineHeight: 1.6 }}>{item.bad}</Text>
          </Box>
          <Box style={{ background: '#16263F', borderRadius: 8, padding: '10px 14px' }}>
            <Text style={{ fontSize: 13, color: '#22D3EE', fontWeight: 'bold', marginBottom: 4 }}>正例</Text>
            <Text style={{ fontSize: 14, color: '#DCE7F5', lineHeight: 1.6 }}>{item.good}</Text>
          </Box>
        </Box>
      ))}
    </Box>

    <Box style={{ marginTop: 18, background: '#DCE7F5', borderRadius: 10, padding: '14px 20px' }}>
      <Text style={{ fontSize: 15, color: '#16263F', fontWeight: 'bold' }}>
        记住：动词开头（列出/写出/重构）+ 说清结果（几个、多长、给谁）
      </Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 3 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>05 / 11</Text>
  </Box>
</Slide>
