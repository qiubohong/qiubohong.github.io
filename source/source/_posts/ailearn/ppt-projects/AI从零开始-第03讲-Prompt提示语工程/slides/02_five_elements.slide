<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>PROMPT ANATOMY</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 14 }}>Prompt 是给模型的工作说明书</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 22 }} />

    <Box style={{ flexDirection: 'row', gap: 16, flex: 1 }}>
      {[
        { n: '①', t: '角色', d: '给 AI 戴职业帽子', e: '「你是资深架构师」', icon: 'user-tie' },
        { n: '②', t: '上下文', d: '给足背景再提问', e: '项目背景 · 约束条件', icon: 'info-circle' },
        { n: '③', t: '指令', d: '动词先行 + 结果导向', e: '做什么 · 怎么做', icon: 'bullseye' },
        { n: '④', t: '范例', d: '给 AI 临摹字帖', e: '示例输入 → 输出', icon: 'copy' },
        { n: '⑤', t: '输出格式', d: '搭好舞台框架', e: '表格 / 代码 / 列表', icon: 'table' },
      ].map((item, idx) => (
        <Box key={idx} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '22px 20px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 14 }}>
            <Text style={{ fontSize: 16, color: '#FF9F1C', fontWeight: 'bold' }}>{item.n}</Text>
            <Box style={{ width: 36, height: 36, borderRadius: 10, background: '#EAF2FB', justifyContent: 'center', alignItems: 'center' }}>
              <FAIcon name={item.icon} style={{ fill: '#22D3EE', width: 18, height: 18 }} />
            </Box>
          </Box>
          <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#16263F', marginBottom: 8 }}>{item.t}</Text>
          <Text style={{ fontSize: 14, color: '#5B6B7A', lineHeight: 1.6, marginBottom: 12 }}>{item.d}</Text>
          <Box style={{ marginTop: 'auto', background: '#F5F7FA', borderRadius: 8, padding: '8px 12px' }}>
            <Text style={{ fontSize: 12, color: '#5B6B7A' }}>{item.e}</Text>
          </Box>
        </Box>
      ))}
    </Box>

    <Box style={{ marginTop: 18, background: '#16263F', borderRadius: 12, padding: '16px 22px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
      <FAIcon name='lightbulb' style={{ fill: '#FF9F1C', width: 20, height: 20 }} />
      <Text style={{ fontSize: 15, color: '#DCE7F5', fontWeight: 'bold' }}>
        五要素不是每句都要齐，但缺一个，模型就只能靠「猜」——猜不准就答非所问
      </Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 3 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>02 / 11</Text>
  </Box>
</Slide>
