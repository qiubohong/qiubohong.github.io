<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>ANTI-HALLUCINATION</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 14 }}>降低 AI 幻觉：让模型不知道就说不知道</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 20 }} />

    <Box style={{ background: '#16263F', borderRadius: 12, padding: '18px 24px', flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 22 }}>
      <FAIcon name='exclamation-triangle' style={{ fill: '#FF9F1C', width: 24, height: 24 }} />
      <Text style={{ fontSize: 16, color: '#DCE7F5', lineHeight: 1.7 }}>
        幻觉 = 模型<span style={{ color: '#FF9F1C', fontWeight: 'bold' }}>一本正经地胡说</span>：它不会承认「我不知道」，而是编一个像模像样的答案。
      </Text>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 22, flex: 1 }}>
      {[
        { t: '允许说不知道', d: '在 Prompt 里写明：「不确定就回答不知道，不要编造」。给模型留退路，它才敢诚实。', icon: 'question-circle', e: '「不知道就说不知道」' },
        { t: '要求引用来源', d: '让模型给出处、给依据，没有来源的结论就打问号，方便你二次核对。', icon: 'quote-left', e: '「请标注信息来源」' },
        { t: '限定知识边界', d: '把回答范围锁在你给的材料里：「只根据以下内容回答」，减少自由发挥。', icon: 'lock', e: '「只依据给定材料」' },
      ].map((item, idx) => (
        <Box key={idx} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '24px 24px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 14 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 12, background: '#EAF2FB', justifyContent: 'center', alignItems: 'center' }}>
              <FAIcon name={item.icon} style={{ fill: '#22D3EE', width: 22, height: 22 }} />
            </Box>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16263F' }}>{item.t}</Text>
          </Box>
          <Text style={{ fontSize: 15, color: '#5B6B7A', lineHeight: 1.8, marginBottom: 14 }}>{item.d}</Text>
          <Box style={{ marginTop: 'auto', background: '#DCE7F5', borderRadius: 8, padding: '10px 14px' }}>
            <Text style={{ fontSize: 14, color: '#16263F', fontWeight: 'bold' }}>{item.e}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 3 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>10 / 11</Text>
  </Box>
</Slide>
