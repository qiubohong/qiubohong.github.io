<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'row', gap: 36 }}>
    <Box style={{ flex: 3, flexDirection: 'column' }}>
      <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>LCEL PRACTICE</Text>
      <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 16 }}>LCEL 实战：流式 / 异步 / 结构化输出</Text>
      <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 18 }} />
      <CodeBlock
        code={`# 流式输出：逐 token 打印
for chunk in chain.stream({"topic": "RAG"}):
    print(chunk, end="")

# 异步：并发场景不阻塞
result = await chain.ainvoke({"topic": "Agent"})

# 结构化输出：解析为 JSON
parser = JsonOutputParser()
chain = prompt | llm | parser`}
        language='python'
        width={620}
        fontSize={13}
      />
    </Box>

    <Box style={{ flex: 2, flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
      {[
        { t: 'stream', d: '长回答边生成边显示，体验像在打字' },
        { t: 'ainvoke', d: 'await 异步，适合 FastAPI 等高并发服务' },
        { t: 'JsonOutputParser', d: '把自由文本变成可编程的 JSON 结构' },
        { t: 'astream_events', d: '监听链上每一步事件，精细排查' },
      ].map((item, idx) => (
        <Box key={idx} style={{ background: '#FFFFFF', borderRadius: 12, padding: '16px 20px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16263F', marginBottom: 4 }}>{item.t}</Text>
          <Text style={{ fontSize: 13, color: '#5B6B7A', lineHeight: 1.6 }}>{item.d}</Text>
        </Box>
      ))}
      <Box style={{ background: '#DCE7F5', borderRadius: 10, padding: '14px 18px' }}>
        <Text style={{ fontSize: 14, color: '#16263F', fontWeight: 'bold' }}>
          关键：同一套 Runnable 接口，切换调用方式零改动
        </Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 4 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>10 / 14</Text>
  </Box>
</Slide>
