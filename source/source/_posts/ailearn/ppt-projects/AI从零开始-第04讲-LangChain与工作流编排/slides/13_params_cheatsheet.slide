<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>PARAM CHEATSHEET</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 24 }}>参数速查卡：四个旋钮，管住输出</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 26 }} />

    <Box style={{ flexDirection: 'row', gap: 20, flex: 1 }}>
      {[
        { t: 'temperature', n: '0 ~ 2', d: '采样温度，越低越确定\n创意写作调高，事实问答调低' },
        { t: 'top_p', n: '0 ~ 1', d: '核采样，只在累计概率前 p 的词里选\n比温度更克制' },
        { t: 'top_k', n: '整数', d: '只保留概率最高的 k 个候选词\n直接截断词表' },
        { t: 'max_tokens', n: '整数', d: '输出长度上限\n防止回答失控超长' },
      ].map((item, idx) => (
        <Box key={idx} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '24px 22px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#16263F', marginBottom: 6, fontFamily: '"JetBrains Mono", monospace' }}>{item.t}</Text>
          <Text style={{ fontSize: 15, color: '#22D3EE', fontWeight: 'bold', marginBottom: 14 }}>{item.n}</Text>
          <Text style={{ fontSize: 13, color: '#5B6B7A', lineHeight: 1.7, whiteSpace: 'pre-line' }}>{item.d}</Text>
        </Box>
      ))}
    </Box>

    <Box style={{ marginTop: 22, background: '#16263F', borderRadius: 12, padding: '18px 24px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <FAIcon name='sliders-h' style={{ fill: '#FF9F1C', width: 26, height: 26 }} />
      <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>
        调参第一原则：<span style={{ color: '#FF9F1C' }}>一次只动一个旋钮</span>，观察效果再动下一个
      </Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 4 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>13 / 14</Text>
  </Box>
</Slide>
