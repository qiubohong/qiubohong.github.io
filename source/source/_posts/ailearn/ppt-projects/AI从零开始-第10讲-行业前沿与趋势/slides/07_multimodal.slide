<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>MULTIMODAL + STRUCTURED</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 24 }}>多模态与结构化输出：打通 AI 的「进出两端」</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 26 }} />

    <Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 16, justifyContent: 'center' }}>
        <Box style={{ background: '#FFFFFF', borderRadius: 12, padding: '20px 24px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 10 }}>
            <FAIcon name='image' style={{ fill: '#22D3EE', width: 24, height: 24 }} />
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16263F' }}>多模态 · 打通输入端</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#5B6B7A', lineHeight: 1.8 }}>图、音、视频都能「看懂」，AI 不再只吃文字。</Text>
        </Box>
        <Box style={{ background: '#16263F', borderRadius: 12, padding: '20px 24px' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 10 }}>
            <FAIcon name='code' style={{ fill: '#FF9F1C', width: 24, height: 24 }} />
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>json_schema · 打通输出端</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#DCE7F5', lineHeight: 1.8 }}>约束输出为结构化 JSON，直接进系统，不用再解析「人话」。</Text>
        </Box>
      </Box>

      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '26px 26px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16263F', marginBottom: 16 }}>场景：发票识别</Text>
        <Box style={{ flexDirection: 'column', gap: 12 }}>
          <Box style={{ background: '#F5F7FA', borderRadius: 10, padding: '14px 18px' }}>
            <Text style={{ fontSize: 13, color: '#5B6B7A', marginBottom: 4 }}>输入</Text>
            <Text style={{ fontSize: 15, color: '#16263F', fontWeight: 'bold' }}>一张发票照片（图像）</Text>
          </Box>
          <Box style={{ justifyContent: 'center', alignItems: 'center', padding: 4 }}>
            <FAIcon name='arrow-down' style={{ fill: '#FF9F1C', width: 20, height: 20 }} />
          </Box>
          <Box style={{ background: '#16263F', borderRadius: 10, padding: '14px 18px' }}>
            <Text style={{ fontSize: 13, color: '#22D3EE', marginBottom: 6 }}>输出（json_schema 约束）</Text>
            <Text style={{ fontSize: 13, color: '#DCE7F5', fontFamily: '"JetBrains Mono", monospace', lineHeight: 1.8 }}>
              {`{"amount": 1280.00, "date": "2026-08-01", "seller": "XX公司"}`}
            </Text>
          </Box>
        </Box>
        <Box style={{ marginTop: 16, background: '#DCE7F5', borderRadius: 8, padding: '12px 16px' }}>
          <Text style={{ fontSize: 13, color: '#16263F', fontWeight: 'bold' }}>从「看懂图」到「吐出可用数据」，一步到位</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 10 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>07 / 11</Text>
  </Box>
</Slide>
