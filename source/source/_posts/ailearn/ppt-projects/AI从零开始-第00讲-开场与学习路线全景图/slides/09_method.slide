<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>HOW TO LEARN</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 14 }}>学习方法：比喻先行 + 动手实验 + 冷知识收尾</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 24 }} />

    <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
      {[
        { n: '01', t: '比喻先行', d: '把抽象概念换成生活比喻，先建立直觉，再补术语。', ex: 'Transformer = 答题时圈重点', icon: 'lightbulb', c: '#22D3EE' },
        { n: '02', t: '动手实验', d: '每讲一个能跑通的 Demo，看代码比看 PPT 记得牢。', ex: '先跑起来，再理解原理', icon: 'laptop-code', c: '#FF9F1C' },
        { n: '03', t: '冷知识收尾', d: '用有趣的数字与反差事实收尾，强化记忆点。', ex: '中文 Token 税 40%~100%', icon: 'snowflake', c: '#22D3EE' },
      ].map((item, idx) => (
        <Box key={idx} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, padding: '28px 26px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Text style={{ fontSize: 14, color: item.c, fontWeight: 'bold', marginBottom: 14 }}>{item.n}</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 14 }}>
            <FAIcon name={item.icon} style={{ fill: item.c, width: 26, height: 26 }} />
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#16263F' }}>{item.t}</Text>
          </Box>
          <Text style={{ fontSize: 15, color: '#5B6B7A', lineHeight: 1.8, marginBottom: 14 }}>{item.d}</Text>
          <Box style={{ marginTop: 'auto', background: '#F5F7FA', borderRadius: 8, padding: '10px 14px' }}>
            <Text style={{ fontSize: 14, color: '#16263F', fontWeight: 'bold' }}>{item.ex}</Text>
          </Box>
        </Box>
      ))}
    </Box>

    <Box style={{ marginTop: 20, background: '#16263F', borderRadius: 12, padding: '16px 22px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
      <FAIcon name='key' style={{ fill: '#FF9F1C', width: 20, height: 20 }} />
      <Text style={{ fontSize: 15, color: '#DCE7F5', fontWeight: 'bold' }}>
        一句话记住：先懂比喻，再动手跑，最后用冷知识封存记忆
      </Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 0 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>09 / 11</Text>
  </Box>
</Slide>
