<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>USE AI WELL</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 14 }}>先用好 AI：九招心法</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 22 }} />

    <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 16, flex: 1 }}>
      {[
        { t: '会提问', d: '问题说清楚，答案才靠谱' },
        { t: '懂审美', d: '能判断产出好坏' },
        { t: '会交底', d: '给足背景再提问' },
        { t: '会迭代', d: '一次不行就追问' },
        { t: '会立规矩', d: '定好输出规则' },
        { t: '会听骂', d: '让 AI 挑你的错' },
        { t: '会压缩', d: '长文先提炼再投喂' },
        { t: '会整理', d: '对话沉淀成资产' },
        { t: '请私教', d: '让 AI 当专属老师' },
      ].map((item, idx) => (
        <Box key={idx} style={{ width: '32%', background: '#FFFFFF', borderRadius: 12, padding: '16px 20px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Text style={{ fontSize: 15, color: '#FF9F1C', fontWeight: 'bold', width: 26 }}>{idx + 1}</Text>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16263F', marginBottom: 4 }}>{item.t}</Text>
            <Text style={{ fontSize: 13, color: '#5B6B7A' }}>{item.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 0 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>10 / 11</Text>
  </Box>
</Slide>
