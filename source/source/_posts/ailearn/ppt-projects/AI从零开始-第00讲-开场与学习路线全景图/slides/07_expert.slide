<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>EXPERT LEVEL</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 14 }}>高级能力：从「会调」到「会造」</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 22 }} />

    <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 18, flex: 1 }}>
      {[
        { t: 'Embedding', d: '文字变向量，机器才懂相近', icon: 'cube' },
        { t: '向量库', d: '语义检索，找「意思」不找字', icon: 'database' },
        { t: 'RAG', d: '检索增强，给模型补知识', icon: 'book-open' },
        { t: 'Agent', d: '自主规划 + 调用工具执行', icon: 'robot' },
        { t: '多模态', d: '图文音视频一起理解', icon: 'images' },
        { t: '微调', d: '领域数据定制专属模型', icon: 'sliders' },
      ].map((item, idx) => (
        <Box key={idx} style={{ width: '32%', background: '#FFFFFF', borderRadius: 12, padding: '20px 22px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 10 }}>
            <Box style={{ width: 40, height: 40, borderRadius: 10, background: '#EAF2FB', justifyContent: 'center', alignItems: 'center' }}>
              <FAIcon name={item.icon} style={{ fill: '#22D3EE', width: 20, height: 20 }} />
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#16263F' }}>{item.t}</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#5B6B7A', lineHeight: 1.6 }}>{item.d}</Text>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 0 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>07 / 11</Text>
  </Box>
</Slide>
