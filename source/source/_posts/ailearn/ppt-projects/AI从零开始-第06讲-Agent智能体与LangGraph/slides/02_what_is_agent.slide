<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ flexDirection: 'row', width: '100%', height: '100%', gap: 40 }}>
    <Box style={{ width: 360, paddingTop: 20 }}>
      <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 12 }}>WHAT IS AGENT</Text>
      <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', lineHeight: 1.35, marginBottom: 24 }}>
        Agent 是什么<br />大脑 + 手 + 反馈闭环
      </Text>
      <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 24 }} />
      <Text style={{ fontSize: 16, color: '#5B6B7A', lineHeight: 1.7 }}>
        <span style={{ fontWeight: 'bold', color: '#16263F' }}>LLM 作推理引擎</span>，决定「下一步做什么」；<span style={{ fontWeight: 'bold', color: '#16263F' }}>工具负责执行</span>，结果再喂回给模型——用行动与反馈，补齐模型的短板。
      </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
      {[
        { t: '无记忆', d: '靠 Memory 补，跨轮记住上下文' },
        { t: '无工具', d: '靠 Function Call 接外部能力' },
        { t: '无规划', d: '靠思维链拆解复杂任务' },
        { t: '会幻觉', d: '靠检索与验证压制编造' },
        { t: '不会验证', d: '靠反馈循环自我纠错' },
      ].map((item, idx) => (
        <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', borderRadius: 12, padding: '15px 22px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
          <Box style={{ width: 46, height: 46, borderRadius: 12, background: '#EAF2FB', justifyContent: 'center', alignItems: 'center' }}>
            <FAIcon name='times-circle' style={{ fill: '#FF9F1C', width: 22, height: 22 }} />
          </Box>
          <Text style={{ width: 130, fontSize: 17, fontWeight: 'bold', color: '#16263F' }}>{item.t}</Text>
          <Text style={{ flex: 1, fontSize: 14, color: '#5B6B7A' }}>{item.d}</Text>
        </Box>
      ))}
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 6 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>02 / 14</Text>
  </Box>
</Slide>
