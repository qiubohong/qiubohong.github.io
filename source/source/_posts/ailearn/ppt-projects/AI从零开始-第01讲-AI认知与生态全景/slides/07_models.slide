<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 8 }}>MODEL LANDSCAPE</Text>
    <Text style={{ fontSize: 34, color: '#16263F', fontWeight: 'bold', marginBottom: 14 }}>主流模型格局 2026-08</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 22 }} />

    <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
      <Box style={{ flex: 5, background: '#16263F', borderRadius: 14, padding: '28px 28px', justifyContent: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 14 }}>
          <FAIcon name='crown' style={{ fill: '#FF9F1C', width: 28, height: 28 }} />
          <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 1 }}>OPEN-SOURCE FLAGSHIP</Text>
        </Box>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF', marginBottom: 10 }}>DeepSeek V4-Flash</Text>
        <Text style={{ fontSize: 15, color: '#DCE7F5', lineHeight: 1.8, marginBottom: 16 }}>
          开源旗舰：MIT 协议、284B 总参 / 13B 激活、1M 上下文，$0.14 / 百万 input——<span style={{ color: '#22D3EE', fontWeight: 'bold' }}>国产开源的代表作</span>。
        </Text>
        <Box style={{ background: 'rgba(34,211,238,0.12)', borderRadius: 8, padding: '10px 14px' }}>
          <Text style={{ fontSize: 14, color: '#22D3EE', fontWeight: 'bold' }}>小参数反超大参数，本地可跑</Text>
        </Box>
      </Box>

      <Box style={{ flex: 5, flexDirection: 'column', gap: 12 }}>
        {[
          { t: 'GPT-5', v: 'OpenAI', d: '综合旗舰 · 生态最成熟', icon: 'rocket' },
          { t: 'Claude Opus 5', v: 'Anthropic', d: '代码与长文强 · 风格克制', icon: 'code' },
          { t: 'Qwen', v: '阿里', d: '国产开源主力 · 中文友好', icon: 'cubes' },
          { t: 'GLM', v: '智谱', d: '国产闭源 · 推理扎实', icon: 'brain' },
          { t: '豆包', v: '字节', d: 'C 端普及度高 · 易上手', icon: 'fire' },
        ].map((item, idx) => (
          <Box key={idx} style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, padding: '12px 18px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 36, height: 36, borderRadius: 10, background: '#EAF2FB', justifyContent: 'center', alignItems: 'center' }}>
              <FAIcon name={item.icon} style={{ fill: '#22D3EE', width: 18, height: 18 }} />
            </Box>
            <Box style={{ flex: 1 }}>
              <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#16263F' }}>{item.t} <span style={{ fontSize: 12, color: '#5B6B7A', fontWeight: 'normal' }}>· {item.v}</span></Text>
              <Text style={{ fontSize: 13, color: '#5B6B7A' }}>{item.d}</Text>
            </Box>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 1 讲 · 数据截至 2026-08</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>07 / 11</Text>
  </Box>
</Slide>
