<Slide
  style={{
    width: '1280px', height: '720px',
    background: '#F5F7FA',
    padding: '20px 60px',
    fontFamily: '"思源黑体", sans-serif',
  }}
>
  <Box style={{ width: '100%', height: '100%' }}>
    <Text style={{ fontSize: 14, color: '#FF9F1C', fontWeight: 'bold', letterSpacing: 2, marginBottom: 6 }}>RAG PIPELINE</Text>
    <Text style={{ fontSize: 32, color: '#16263F', fontWeight: 'bold', marginBottom: 12 }}>RAG 原理：Retriever + Generator 双引擎</Text>
    <Box style={{ width: 56, height: 4, background: '#22D3EE', marginBottom: 18 }} />

    <Box style={{ flexDirection: 'row', alignItems: 'stretch', gap: 28, flex: 1, marginBottom: 12 }}>
      <Box style={{ flex: 6, justifyContent: 'center' }}>
        {[
          [
            { n: '01', t: '加载', e: 'Load', d: '读取 PDF/网页/数据库' },
            { n: '02', t: '分割', e: 'Split', d: '切成带上下文的片段' },
            { n: '03', t: '向量化', e: 'Embed', d: '文本转为高维向量' },
          ],
          [
            { n: '04', t: '存储', e: 'Store', d: '向量入库建索引' },
            { n: '05', t: '检索', e: 'Retrieve', d: '按语义找最相关片段' },
            { n: '06', t: '生成', e: 'Generate', d: 'LLM 结合检索结果作答' },
          ],
        ].map((row, rowIdx) => (
          <Box key={rowIdx} style={{ flexDirection: 'row', gap: 10, marginBottom: 10 }}>
            {row.map((item, idx) => (
              <Box key={idx} style={{ flex: 1, height: 112, background: '#FFFFFF', borderRadius: 12, padding: '12px 11px', boxShadow: '0 2px 12px rgba(22,38,63,0.06)' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 7, marginBottom: 4 }}>
                  <Text style={{ fontSize: 11, color: '#FF9F1C', fontWeight: 'bold' }}>{item.n}</Text>
                  <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#16263F' }}>{item.t}</Text>
                </Box>
                <Text style={{ fontSize: 11, color: '#22A9C0', fontWeight: 'bold', fontFamily: '"JetBrains Mono", monospace', marginBottom: 5 }}>{item.e}</Text>
                <Text style={{ fontSize: 11, color: '#5B6B7A', lineHeight: 1.45 }}>{item.d}</Text>
              </Box>
            ))}
          </Box>
        ))}

        <Box style={{ marginTop: 6, background: '#16263F', borderRadius: 14, padding: '18px 20px' }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
            <FAIcon name='sitemap' style={{ fill: '#FF9F1C', width: 24, height: 24 }} />
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>两个关键角色</Text>
          </Box>
          <Text style={{ fontSize: 14, color: '#DCE7F5', lineHeight: 1.75 }}>
            <span style={{ color: '#22D3EE', fontWeight: 'bold' }}>Retriever（检索器）</span>负责「查什么」，<span style={{ color: '#22D3EE', fontWeight: 'bold' }}>Generator（生成器）</span>负责「怎么答」——检索片段作为上下文喂给模型，答案就有了事实依据。
          </Text>
        </Box>
      </Box>

      <Box style={{ flex: 5, background: '#FFFFFF', borderRadius: 14, padding: 14, boxShadow: '0 2px 12px rgba(22,38,63,0.06)', justifyContent: 'center' }}>
        <Image
          src='assets/rag_retriever_generator_robots.png'
          style={{ width: '100%', height: 340, objectFit: 'cover', borderRadius: 12, marginBottom: 16 }}
        />
        <Box style={{ background: '#EAF2FB', borderRadius: 12, padding: '16px 18px' }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#16263F', marginBottom: 6 }}>看图理解：先查资料，再回答</Text>
          <Text style={{ fontSize: 14, color: '#5B6B7A', lineHeight: 1.7 }}>
            左侧 Retriever 找出相关资料，右侧 Generator 基于资料生成答案。
          </Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 14, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>AI 从零开始 · 第 5 讲</Text>
    <Text style={{ fontSize: 14, color: '#5B6B7A' }}>03 / 11</Text>
  </Box>
</Slide>
